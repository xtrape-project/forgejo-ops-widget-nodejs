# Copy to widget.env, restrict it to the deployment operator, and inject real
# secrets through the deployment secret store. Never commit widget.env.

FORGEJO_OPS_WIDGET_TRANSPORT_MODE=WORLD_A
FORGEJO_OPS_WIDGET_PLATFORM_URL=https://platform.xtrape.com
FORGEJO_OPS_WIDGET_REGISTRATION_TOKEN=replace-with-widget-token
FORGEJO_OPS_WIDGET_CALLBACK_TOKEN=replace-with-random-callback-token
FORGEJO_OPS_WIDGET_CALLBACK_HOST=0.0.0.0
FORGEJO_OPS_WIDGET_CALLBACK_PORT=8080
FORGEJO_OPS_WIDGET_CALLBACK_ADDRESS=https://forgejo-ops-widget.example.com
FORGEJO_OPS_WIDGET_CONF_DIR=/app/conf

# --- Governed read-only profile (#7) ---------------------------------------
# Provision BOTH (or neither, to run inert / health-only). Only the
# `collaboration` credential is accepted; the administration credential and
# FORGEJO_OPS_ENABLE_DESTRUCTIVE are refused — writes are 0.8.7 non-goals.
#FORGEJO_OPS_FORGEJO_URL=https://forgejo.example.com
#FORGEJO_OPS_COLLABORATION_TOKEN=replace-with-forgejo-api-token

# Optional: narrow the served Checkpoint set (comma-separated; known ids:
# repository.get, issue.get, pull-request.get). Present-but-empty fails closed.
#FORGEJO_OPS_BOUNDED_CHECKPOINTS=repository.get,issue.get,pull-request.get

# World A: optional pin on which admitted execution profile the Checkpoint
# factory selects. World B: REQUIRED when the target above is set — a
# listen-only Widget cannot discover the admitted profile, so the operator
# pins the digest the Platform admitted, and admits the extractor artifacts
# printed by `node scripts/print-extractor-artifacts.mjs`.
#FORGEJO_OPS_EXECUTION_PROFILE_DIGEST=sha256:replace-with-admitted-profile-digest
